# ──────────────────────────────────────────────────────────────────────────────
# Assetra — Environment Variables
# Copy this file to .env and fill in real values before running.
#
# NEVER commit the real .env to git. .env is in .gitignore.
# ──────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
# These are consumed by docker-compose to configure the postgres service.
POSTGRES_DB=assetra
POSTGRES_USER=assetra
# REQUIRED — pick a strong password; no default is provided here intentionally.
POSTGRES_PASSWORD=change-me-before-running
# Host port that postgres is mapped to (change if 5432 is already in use locally)
POSTGRES_PORT=5432

# ── Backend — FastAPI ──────────────────────────────────────────────────────────
ASSETRA_APP_NAME=Assetra API
ASSETRA_ENVIRONMENT=local
ASSETRA_DEBUG=true
ASSETRA_API_V1_PREFIX=/api/v1

# Database URL used by the backend process.
# When running with docker compose, this is overridden automatically by compose
# to point at the postgres service (host = "postgres").
# For local development without Docker, keep localhost:5432.
ASSETRA_DATABASE_URL=postgresql+psycopg://assetra:change-me-before-running@localhost:5432/assetra

# JWT — REQUIRED. Use `openssl rand -hex 32` to generate a secure value.
ASSETRA_JWT_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ASSETRA_ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS — the origin your frontend is served from.
# Docker local dev: http://localhost:5173
# Deployed: https://your-frontend-domain.com
ASSETRA_FRONTEND_ORIGIN=http://localhost:5173

# Seed demo data on container startup? true | false
# Set to true on first run to populate the database, then switch back to false.
ASSETRA_SEED_ON_STARTUP=false

# Uvicorn tuning (optional)
UVICORN_WORKERS=1
UVICORN_LOG_LEVEL=info

# Exposed host port for the backend API
BACKEND_PORT=8000

# ── Frontend (React/Nginx) ─────────────────────────────────────────────────────
# Exposed host port for the frontend application
FRONTEND_PORT=8080
