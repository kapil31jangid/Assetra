# ── Python artifacts ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.eggs/
dist/
build/

# ── Virtual environments ───────────────────────────────────────────────────────
.venv/
venv/
env/

# ── Tests and CI ──────────────────────────────────────────────────────────────
.pytest_cache/
.ruff_cache/
tests/
htmlcov/
.coverage

# ── Development secrets ───────────────────────────────────────────────────────
.env
# .env.example is intentionally NOT excluded — it documents required variables

# ── Uploads (bind-mounted as a named volume at runtime) ───────────────────────
uploads/

# ── Editor ────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp

# ── Git ───────────────────────────────────────────────────────────────────────
.git/
.gitignore
